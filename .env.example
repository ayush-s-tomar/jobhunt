# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=generate_with__python_-c_"import secrets; print(secrets.token_hex(32))"
FERNET_KEY=generate_with__python_-c_"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/jobhunt.db
# Production (PostgreSQL on Render — Render sets this automatically via render.yaml):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# ── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Your Name

# ── CORS (production only) ────────────────────────────────────────────────────
# Set to your Render URL after deploying, e.g:
# ALLOWED_ORIGINS=https://jobhunt.onrender.com
ALLOWED_ORIGINS=http://localhost:8000

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=15
MAX_JOBS_PER_POLL=50
